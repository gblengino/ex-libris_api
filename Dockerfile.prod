FROM python:3.12-slim

# Evitar archivos .pyc y habilitar logs en tiempo real
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# Instalar uv
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

WORKDIR /app

# Copiar archivos de dependencias
COPY pyproject.toml uv.lock ./

# Instalar dependencias de producción
RUN uv sync --frozen --no-dev --no-install-project

# Incorporar el entorno virtual al PATH
ENV PATH="/app/.venv/bin:$PATH"

# Copiar código fuente
COPY . .

# Crear directorios para archivos estáticos y multimedia
RUN mkdir -p /app/staticfiles /app/media

# Puerto interno de Gunicorn
EXPOSE 8000

# Iniciar Django mediante Gunicorn
CMD ["gunicorn", "--chdir", "src", "config.wsgi:application", "--bind", "0.0.0.0:8000", "--workers", "3"]
